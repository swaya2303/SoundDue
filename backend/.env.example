# SoundDue Backend Environment Variables (Optional)
# Port is typically set automatically by platforms like Render, Railway, or Heroku
PORT=8000

# Optional: Comma-separated list of additional allowed origins for CORS (e.g. for custom domains)
# Note: Localhost and any *.vercel.app domain are allowed by default
ALLOWED_ORIGINS=https://sounddue.vercel.app

# Optional LLM rewrite for export findings (disabled by default)
# SOUNDDUE_LLM_REWRITE=1
# OPENAI_API_KEY=sk-...
